<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/white"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cat_brown"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDealer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dealer_label"
            android:visibility="gone"
            android:textSize="10sp"
            app:chipBackgroundColor="@color/cat_yellow"/>

        <!-- Bid picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBidMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="-"
            android:textSize="20sp"
            android:backgroundTint="@color/cat_orange"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

        <TextView
            android:id="@+id/tvBidValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cat_brown"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBidPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="20sp"
            android:backgroundTint="@color/cat_orange"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvForbiddenNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/error_red"
        android:visibility="gone"
        android:layout_marginTop="2dp"/>

</LinearLayout>
