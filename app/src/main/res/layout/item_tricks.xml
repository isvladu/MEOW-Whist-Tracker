<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@android:color/white"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cat_brown"/>

        <TextView
            android:id="@+id/tvBidLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvHitMiss"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginEnd="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTricksMinus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="-"
        android:textSize="20sp"
        android:backgroundTint="@color/cat_orange"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"/>

    <TextView
        android:id="@+id/tvTricksValue"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/cat_brown"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTricksPlus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="+"
        android:textSize="20sp"
        android:backgroundTint="@color/cat_orange"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"/>

</LinearLayout>
